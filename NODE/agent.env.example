# 节点 ID（在 WEB 后台创建节点后获得）
NODE_ID=1
# Agent 令牌（创建节点时返回，或通过「重置令牌」获取）
AGENT_TOKEN=your-agent-token-here
# collector 配置接口的签名密钥只允许放在安装目录外的受保护文件（Linux 0600）。
# 文件不存在或权限不合格时，/workload/collector/* 必须 fail-closed。
AGENT_SIGNING_KEY_FILE=/etc/easyaiot/node-agent/agent-signing-key
AGENT_REPLAY_DB=/var/lib/easyaiot/node-agent/replay-window.db
# 控制面宿主机 Agent 设为 1，启动时从 bootstrap 同步凭据（数据库重建后自动修复 nodeId）
# 远程计算节点部署时由平台写入 PLATFORM_AGENT=0，请勿改为 1
# PLATFORM_AGENT=1
# 控制面地址（经 Gateway）
CONTROL_PLANE_URL=http://localhost:48080/admin-api/node/agent
# 心跳间隔（秒）
HEARTBEAT_INTERVAL=10
# Agent HTTP 监听
AGENT_LISTEN_HOST=0.0.0.0
AGENT_LISTEN_PORT=9100
# AI 代码根目录（远程部署模型服务）
AI_ROOT=/opt/easyaiot/AI
# VIDEO 代码根目录（远程部署算法任务）
VIDEO_ROOT=/opt/easyaiot/VIDEO
# 媒体集群脚本目录（远程部署 SRS/ZLM）
MEDIA_CLUSTER_ROOT=/opt/easyaiot/media-cluster
# MQTT 网关集群脚本目录（远程部署 EMQX）
MQTT_CLUSTER_ROOT=/opt/easyaiot/mqtt-cluster
# MinIO（远程下载模型）
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your-secret

# collector 专用部署策略（安装时必须由本机 capability 清单显式填写；留空即 fail-closed）
# 电力运维 collector 仅支持 standard/full，mini 请求返回 COLLECTOR_PROFILE_UNSUPPORTED。
COLLECTOR_DEPLOY_PROFILE=full
# 每一项必须是不可拆分的 repository@sha256:<64 位小写 hex>，禁止只填 repository/tag。
COLLECTOR_IMAGE_ALLOWLIST=
# 配置状态根与 outbox 根均由本机安装策略决定，远端 WorkloadSpec 不得选择宿主机路径。
COLLECTOR_STATE_ROOT=/var/lib/easyaiot/collector-state
COLLECTOR_ROOT=/var/lib/easyaiot/collector
# Linux 安装资格固定校验：identity/config/history 目录 02770（setgid），
# desired/active/observed/history/lock 文件 0660；Agent 不会自动修复既有错误权限。
# 本地 Windows 仅执行可移植状态逻辑，不代表 owner/group/GID 资格已通过。
# 仅填写安装时批准的规范串口路径，逗号/换行分隔；不写入 secret。
COLLECTOR_SERIAL_ALLOWLIST=
# CPU 与内存配额必须显式配置，不提供生产默认值。
COLLECTOR_CPU_MAX=
COLLECTOR_MEMORY_MAX_BYTES=
# Windows collector capability 默认关闭；未完成 COM/ACL 资格前保持 0。
COLLECTOR_WINDOWS_ENABLED=0
# 仅在完成独立 Windows 资格并由安装器注入时填写；默认空值不会开启 capability。
COLLECTOR_WINDOWS_JAVA=
COLLECTOR_WINDOWS_JAR=
COLLECTOR_WINDOWS_RUNTIME_POLICY=
COLLECTOR_WINDOWS_RUNTIME_POLICY_ID=
# 可选的本机平台识别结果（留空自动按 Agent OS 判定）；不得由远端请求覆盖。
COLLECTOR_AGENT_PLATFORM=
