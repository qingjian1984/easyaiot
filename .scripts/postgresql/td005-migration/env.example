# TD-005 受控迁移执行器环境变量示例
# 复制为 .env 并填写实际值；禁止提交真实密码

PG_CONTAINER=postgres-server
PG_USER=postgres
PG_PASSWORD=
PG_DB=iot-device20

# advisory lock 键值：TD005_MIG_LOCK 的评审候选稳定键，更换须同步 ADR-013
LOCK_KEY=913005

# 超时与重试（ADR-013 配置清单候选值，压测后冻结）
CONNECT_TIMEOUT=3
LOCK_WAIT=15s
STATEMENT_TIMEOUT=15s
M15_STATEMENT_TIMEOUT=30min
RETRY_MAX=3
RETRY_BASE_DELAY=1
RETRY_MAX_DELAY=4

# REQUIRE_IDEMPOTENCY=1：precheck 强制要求幂等表已存在（适用于 M05 之前的既有环境）；
# 新装环境保持 0，由 M05 步骤在建链首步正式落库 power_idempotency_record
REQUIRE_IDEMPOTENCY=0
SKIP_PRECHECK=0

# apply/uninstall 必填：审批单 ID
APPROVAL=

# apply/uninstall 必填：执行前自动 pg_dump 备份目录（缺失即拒绝执行）
BACKUP_DIR=

# 可选：只执行单个步骤（默认按依赖顺序执行全部未完成步骤）
# STEP_ONLY=V001

# TD-006 V011/U011 仅评审路径。默认关闭；只有显式 --step V011/U011 时使用。
# 数据库名必须匹配 td006_review_<lowercase>，并与实际 current_database() 一致。
# system_identifier 必须从获准隔离临时 PostgreSQL 实例单独取得；不得填写目标/共享实例。
TD006_REVIEW_ONLY=0
TD006_TEMP_DB=
TD006_TEMP_SYSTEM_IDENTIFIER=
# 额外禁用库名，逗号分隔；iot-device20/postgres/template0/template1 已内置禁用。
TD006_DENY_DATABASES=

# 可选：步骤 SQL 覆盖（默认引用 .doc 评审资产与 steps/ 目录）
# M05_SQL=
# M15_SQL=
# M16_SQL=
# V001_SQL=
# V002_SQL=
# V003_SQL=
# V004_SQL=
# V005_SQL=
# V006_SQL=
# V007_SQL=
# V008_SQL=
# V010_SQL=
# V009_SQL=
# V011_SQL=
# U001_SQL=
# U011_SQL=
