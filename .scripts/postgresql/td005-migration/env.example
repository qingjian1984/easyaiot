# TD-005 受控迁移执行器环境变量示例
# 复制为 .env 并填写实际值；禁止提交真实密码

PG_CONTAINER=postgres-server
PG_USER=postgres
PG_PASSWORD=
PG_DB=iot-device20

LOCK_KEY=913005
CONNECT_TIMEOUT=3
REQUIRE_IDEMPOTENCY=0
SKIP_PRECHECK=0

# apply/uninstall 时必填
APPROVAL=

# 可选：apply 前自动备份目录
BACKUP_DIR=

# 可选：步骤 SQL 覆盖（默认引用 .doc 评审资产）
# M15_SQL=
# V001_SQL=
# U001_SQL=
