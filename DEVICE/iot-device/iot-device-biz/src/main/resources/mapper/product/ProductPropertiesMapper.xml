    <select id="selectProductPropertiesList"
            parameterType="com.basiclab.iot.device.dal.dataobject.product.ProductPropertyDO"
            resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM product_properties
        <where>
            <if test="propertyCode != null and propertyCode != ''">AND property_code = #{propertyCode}</if>
            <if test="propertyName != null and propertyName != ''">AND property_name = #{propertyName}</if>
            <if test="datatype != null and datatype != ''">AND datatype = #{datatype}</if>
            <choose>
                <when test="templateIdentification != null and templateIdentification != '' and productIdentification != null and productIdentification != ''">
                    AND 1 = 0
                </when>
                <when test="templateIdentification != null and templateIdentification != ''">
                    AND template_identification = #{templateIdentification}
                    AND product_identification IS NULL
                </when>
                <when test="productIdentification != null and productIdentification != ''">
                    AND product_identification = #{productIdentification}
                    AND template_identification IS NULL
                </when>
            </choose>
        </where>
        ORDER BY update_time DESC NULLS LAST, id
    </select>

