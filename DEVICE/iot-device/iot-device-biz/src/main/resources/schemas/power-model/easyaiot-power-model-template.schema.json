{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaiot.local/schemas/power-model-template/1.0.0",
  "title": "EasyAIoT 电力物模型模板",
  "description": "POWER-SPEC-002 / ADR-009 的 M1 可发布模板契约。寄存器地址不属于本 Schema。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateCode",
    "templateName",
    "deviceType",
    "templateKind",
    "version",
    "properties",
    "events",
    "services"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "templateCode": { "$ref": "#/$defs/code" },
    "templateName": { "$ref": "#/$defs/name" },
    "deviceType": {
      "type": "string",
      "enum": [
        "HIGH_VOLTAGE_CABINET",
        "PROTECTION_DEVICE",
        "TRANSFORMER",
        "DC_PANEL",
        "LOW_VOLTAGE_CABINET",
        "CAPACITOR_CABINET",
        "METER",
        "CURRENT_TRANSFORMER",
        "VOLTAGE_TRANSFORMER",
        "ENVIRONMENT_MONITOR"
      ]
    },
    "templateKind": { "type": "string", "enum": ["STANDARD", "VENDOR"] },
    "version": { "$ref": "#/$defs/semver" },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templateCode", "version", "contentHash"],
      "properties": {
        "templateCode": { "$ref": "#/$defs/code" },
        "version": { "$ref": "#/$defs/semver" },
        "contentHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "description": { "type": "string", "maxLength": 1000 },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 50 }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/property" }
    },
    "events": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/event" }
    },
    "services": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/service" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "templateKind": { "const": "VENDOR" } } },
      "then": { "required": ["base"] },
      "else": { "not": { "required": ["base"] } }
    }
  ],
  "$defs": {
    "code": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decimal": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "$ref": "#/$defs/name" }
      }
    },
    "standardMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard", "identifier"],
      "properties": {
        "standard": { "type": "string", "minLength": 1, "maxLength": 32 },
        "identifier": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "sampleHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["PERIODIC", "CHANGE", "ON_DEMAND"] },
        "intervalMs": { "type": "integer", "minimum": 100, "maximum": 86400000 },
        "deadband": { "$ref": "#/$defs/decimal" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "PERIODIC" } } },
          "then": { "required": ["intervalMs"] }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterCode", "parameterName", "dataType", "required"],
      "properties": {
        "parameterCode": { "$ref": "#/$defs/code" },
        "parameterName": { "$ref": "#/$defs/name" },
        "dataType": { "$ref": "#/$defs/dataType" },
        "unit": { "type": "string", "maxLength": 32 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 18 },
        "min": { "$ref": "#/$defs/decimal" },
        "max": { "$ref": "#/$defs/decimal" },
        "enumValues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/enumValue" }
        },
        "required": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "dataType": {
      "type": "string",
      "enum": ["BOOL", "INT", "UINT", "FLOAT", "DOUBLE", "STRING", "ENUM", "BITMAP"]
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "propertyCode",
        "propertyName",
        "dataType",
        "accessMode",
        "semanticType",
        "sampleHint",
        "required"
      ],
      "properties": {
        "propertyCode": { "$ref": "#/$defs/code" },
        "propertyName": { "$ref": "#/$defs/name" },
        "dataType": { "$ref": "#/$defs/dataType" },
        "accessMode": { "type": "string", "enum": ["R", "W", "RW"] },
        "unit": { "type": "string", "maxLength": 32 },
        "precision": { "type": "integer", "minimum": 0, "maximum": 18 },
        "roundingMode": { "type": "string", "enum": ["HALF_UP"] },
        "min": { "$ref": "#/$defs/decimal" },
        "max": { "$ref": "#/$defs/decimal" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "enumValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/enumValue" }
        },
        "bitmapValues": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bit", "label"],
            "properties": {
              "bit": { "type": "integer", "minimum": 0, "maximum": 63 },
              "label": { "$ref": "#/$defs/name" }
            }
          }
        },
        "semanticType": {
          "type": "string",
          "enum": ["INSTANTANEOUS", "CUMULATIVE", "STATE", "CONFIGURATION", "IDENTITY"]
        },
        "sampleHint": { "$ref": "#/$defs/sampleHint" },
        "required": { "type": "boolean" },
        "critical": { "type": "boolean", "default": false },
        "description": { "type": "string", "maxLength": 500 },
        "standardMappings": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/standardMapping" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "dataType": { "enum": ["FLOAT", "DOUBLE"] } } },
          "then": { "required": ["precision", "roundingMode"] }
        },
        {
          "if": { "properties": { "dataType": { "const": "ENUM" } } },
          "then": { "required": ["enumValues"] }
        },
        {
          "if": { "properties": { "dataType": { "const": "BITMAP" } } },
          "then": { "required": ["bitmapValues"] }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventCode", "eventName", "defaultSeverity", "ackRequired", "inputs"],
      "properties": {
        "eventCode": { "$ref": "#/$defs/code" },
        "eventName": { "$ref": "#/$defs/name" },
        "defaultSeverity": { "type": "string", "enum": ["INFO", "WARNING", "MAJOR", "CRITICAL"] },
        "ackRequired": { "type": "boolean" },
        "inputs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/parameter" } },
        "alarmPolicySuggestion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "recoveryDurationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "notify": { "type": "boolean" }
          }
        },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceCode",
        "serviceName",
        "riskLevel",
        "inputs",
        "outputs",
        "timeoutMs",
        "idempotency"
      ],
      "properties": {
        "serviceCode": { "$ref": "#/$defs/code" },
        "serviceName": { "$ref": "#/$defs/name" },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH_RISK"] },
        "inputs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/parameter" } },
        "outputs": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/parameter" } },
        "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "idempotency": { "type": "string", "enum": ["REQUIRED", "OPTIONAL", "NOT_SUPPORTED"] },
        "safetyPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approvalRequired": { "type": "boolean" },
            "secondConfirmationRequired": { "type": "boolean" },
            "deviceFeedbackRequired": { "type": "boolean" }
          }
        },
        "description": { "type": "string", "maxLength": 500 }
      },
      "allOf": [
        {
          "if": { "properties": { "riskLevel": { "const": "HIGH_RISK" } } },
          "then": {
            "required": ["safetyPolicy"],
            "properties": {
              "safetyPolicy": {
                "required": ["approvalRequired", "secondConfirmationRequired", "deviceFeedbackRequired"],
                "properties": {
                  "approvalRequired": { "const": true },
                  "secondConfirmationRequired": { "const": true },
                  "deviceFeedbackRequired": { "const": true }
                }
              }
            }
          }
        }
      ]
    }
  }
}
