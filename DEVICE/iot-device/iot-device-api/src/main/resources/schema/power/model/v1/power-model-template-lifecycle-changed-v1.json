{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaiot.local/schemas/power-model-template-lifecycle-changed-v1.json",
  "title": "POWER_MODEL_TEMPLATE_LIFECYCLE_CHANGED_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "occurredAt",
    "requestId",
    "traceId",
    "data"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventType": {
      "const": "POWER_MODEL_TEMPLATE_LIFECYCLE_CHANGED_V1"
    },
    "schemaVersion": {
      "const": 1
    },
    "tenantId": {
      "type": "string"
    },
    "aggregateType": {
      "const": "power_model_template"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "traceId": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateCode",
        "templateVersion",
        "fromLifecycle",
        "toLifecycle",
        "changedAt",
        "changedBy"
      ],
      "properties": {
        "templateCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "templateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fromLifecycle": {
          "enum": ["DRAFT", "PUBLISHED", "DEPRECATED"]
        },
        "toLifecycle": {
          "enum": ["PUBLISHED", "DEPRECATED", "RETIRED"]
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changedBy": {
          "type": "string"
        }
      }
    }
  }
}
