{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaiot.local/events/device.alarm.escalated/v1",
  "title": "device.alarm.escalated.v1",
  "description": "正交告警升级领域事件；升级不改变主状态。",
  "type": "object",
  "required": ["eventId", "eventVersion", "eventType", "tenantId", "occurredAt", "recordedAt", "source", "correlationId", "payload"],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "eventType": {
      "const": "device.alarm.escalated.v1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "iot-device"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "traceId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": ["alarmId", "status", "fromLevel", "toLevel", "policyId", "policyVersion", "escalatedAt", "version"],
      "properties": {
        "alarmId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "status": {
          "enum": ["ACTIVE", "ACKNOWLEDGED", "PROCESSING"]
        },
        "fromLevel": {
          "type": "integer",
          "minimum": 0
        },
        "toLevel": {
          "type": "integer",
          "minimum": 1
        },
        "policyId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "escalatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
