{
  "dictionaryVersion": "1.0.2",
  "schemaVersion": "1.0.0",
  "status": "REVIEW_CANDIDATE",
  "description": "M1 标准电力物模型点位基线。地址、功能码、字节序、缩放和从站号属于 RTUPointBindings，不属于标准模板。",
  "normalizationRules": {
    "currentTransformerRatio": {
      "deviceType": "CURRENT_TRANSFORMER",
      "propertyCode": "transformation-ratio",
      "calculation": "rated-primary-current / rated-secondary-current",
      "normalizedValue": "raw-secondary-value * transformation-ratio",
      "arithmetic": "BASE10_ARBITRARY_PRECISION",
      "precision": 6,
      "precisionScope": "RATIO_STORAGE_AND_COMPARISON",
      "roundingMode": "HALF_UP",
      "intermediateRounding": "NONE",
      "outputPrecisionSource": "TARGET_PROPERTY",
      "outputRoundingModeSource": "TARGET_PROPERTY",
      "valueEncoding": "decimal-string",
      "constraints": "rated-secondary-current > 0; explicit ratio MUST equal the server-calculated 6-decimal ratio; final normalized output MUST use target-property precision"
    },
    "voltageTransformerRatio": {
      "deviceType": "VOLTAGE_TRANSFORMER",
      "propertyCode": "transformation-ratio",
      "calculation": "rated-primary-voltage / rated-secondary-voltage",
      "normalizedValue": "raw-secondary-value * transformation-ratio",
      "arithmetic": "BASE10_ARBITRARY_PRECISION",
      "precision": 6,
      "precisionScope": "RATIO_STORAGE_AND_COMPARISON",
      "roundingMode": "HALF_UP",
      "intermediateRounding": "NONE",
      "outputPrecisionSource": "TARGET_PROPERTY",
      "outputRoundingModeSource": "TARGET_PROPERTY",
      "valueEncoding": "decimal-string",
      "constraints": "rated-secondary-voltage > 0; explicit ratio MUST equal the server-calculated 6-decimal ratio; final normalized output MUST use target-property precision"
    }
  },
