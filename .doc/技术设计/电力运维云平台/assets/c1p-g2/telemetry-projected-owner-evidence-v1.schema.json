{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaiot.local/contracts/telemetry-projected-owner-evidence/v1",
  "title": "EasyAIoT TELEMETRY_PROJECTED owner evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalizationVersion",
    "documentStatus",
    "revision",
    "publicationHistory",
    "eventVersionDecision",
    "artifacts",
    "requiredFields",
    "testCoverage",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "canonicalizationVersion": { "const": "jcs-rfc8785-v1" },
    "documentStatus": { "enum": ["DRAFT", "APPROVED"] },
    "revision": { "type": "integer", "minimum": 1 },
    "publicationHistory": { "$ref": "#/$defs/publicationHistory" },
    "eventVersionDecision": { "$ref": "#/$defs/eventVersionDecision" },
    "artifacts": { "$ref": "#/$defs/artifacts" },
    "requiredFields": {
      "type": "array",
      "items": { "$ref": "#/$defs/requiredField" },
      "uniqueItems": true,
      "maxItems": 23
    },
    "testCoverage": {
      "type": "array",
      "items": { "$ref": "#/$defs/testArea" },
      "uniqueItems": true,
      "maxItems": 7
    },
    "approval": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/approval" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "documentStatus": { "const": "DRAFT" } },
        "required": ["documentStatus"]
      },
      "then": { "properties": { "approval": { "type": "null" } } }
    },
    {
      "if": {
        "properties": { "documentStatus": { "const": "APPROVED" } },
        "required": ["documentStatus"]
      },
      "then": {
        "properties": {
          "publicationHistory": {
            "type": "object",
            "properties": {
              "status": { "enum": ["NEVER_PUBLISHED", "PUBLISHED"] }
            }
          },
          "eventVersionDecision": {
            "type": "object",
            "properties": {
              "decision": {
                "enum": ["EXTEND_V1_BEFORE_FIRST_PUBLISH", "CREATE_V2"]
              }
            }
          },
          "artifacts": {
            "type": "object",
            "properties": {
              "tdDocument": { "$ref": "#/$defs/versionedArtifact" },
              "productionSchema": {
                "$ref": "#/$defs/productionSchemaArtifact"
              },
              "testPlan": { "$ref": "#/$defs/artifact" }
            }
          },
          "requiredFields": { "type": "array", "minItems": 23 },
          "testCoverage": { "type": "array", "minItems": 7 },
          "approval": { "$ref": "#/$defs/approval" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "publicationHistory": {
            "type": "object",
            "properties": { "status": { "const": "UNCONFIRMED" } },
            "required": ["status"]
          }
        },
        "required": ["publicationHistory"]
      },
      "then": {
        "properties": {
          "eventVersionDecision": {
            "type": "object",
            "properties": { "decision": { "const": "UNDECIDED" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventVersionDecision": {
            "type": "object",
            "properties": {
              "decision": { "const": "EXTEND_V1_BEFORE_FIRST_PUBLISH" }
            },
            "required": ["decision"]
          }
        },
        "required": ["eventVersionDecision"]
      },
      "then": {
        "properties": {
          "publicationHistory": {
            "type": "object",
            "properties": { "status": { "const": "NEVER_PUBLISHED" } }
          },
          "eventVersionDecision": {
            "type": "object",
            "properties": {
              "targetEventType": { "const": "TELEMETRY_PROJECTED_V1" },
              "targetSchemaVersion": {
                "type": "string",
                "pattern": "^1\\.[0-9]+$"
              },
              "migrationPlan": { "type": "null" }
            }
          },
          "artifacts": {
            "type": "object",
            "properties": {
              "productionSchema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^DEVICE/iot-sink/iot-sink-api/src/main/resources/events/[^/]+/v1\\.json$"
                  },
                  "eventType": { "const": "TELEMETRY_PROJECTED_V1" },
                  "schemaVersion": {
                    "type": "string",
                    "pattern": "^1\\.[0-9]+$"
                  }
                }
              },
              "consumerInventory": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventVersionDecision": {
            "type": "object",
            "properties": { "decision": { "const": "CREATE_V2" } },
            "required": ["decision"]
          }
        },
        "required": ["eventVersionDecision"]
      },
      "then": {
        "properties": {
          "publicationHistory": {
            "type": "object",
            "properties": { "status": { "const": "PUBLISHED" } }
          },
          "eventVersionDecision": {
            "type": "object",
            "properties": {
              "targetEventType": { "const": "TELEMETRY_PROJECTED_V2" },
              "targetSchemaVersion": {
                "type": "string",
                "pattern": "^2\\.[0-9]+$"
              },
              "migrationPlan": { "$ref": "#/$defs/artifact" }
            }
          },
          "artifacts": {
            "type": "object",
            "properties": {
              "productionSchema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^DEVICE/iot-sink/iot-sink-api/src/main/resources/events/[^/]+/v2\\.json$"
                  },
                  "eventType": { "const": "TELEMETRY_PROJECTED_V2" },
                  "schemaVersion": {
                    "type": "string",
                    "pattern": "^2\\.[0-9]+$"
                  }
                }
              },
              "consumerInventory": { "$ref": "#/$defs/artifact" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*://)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000-\\u001F]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "documentVersion"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "documentVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "productionSchemaArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "eventType", "schemaVersion"],
      "properties": {
        "path": {
          "allOf": [
            { "$ref": "#/$defs/repoPath" },
            {
              "type": "string",
              "pattern": "^DEVICE/iot-sink/iot-sink-api/src/main/resources/events/[^/]+/v[12]\\.json$"
            }
          ]
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "eventType": {
          "enum": ["TELEMETRY_PROJECTED_V1", "TELEMETRY_PROJECTED_V2"]
        },
        "schemaVersion": { "type": "string", "pattern": "^[12]\\.[0-9]+$" }
      }
    },
    "publishedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "firstPublishedAt",
        "latestPublishedAt",
        "publishedEventType",
        "publishedSchemaVersion",
        "currentConsumers"
      ],
      "properties": {
        "environmentId": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "firstPublishedAt": { "type": "string", "format": "date-time" },
        "latestPublishedAt": { "type": "string", "format": "date-time" },
        "publishedEventType": { "const": "TELEMETRY_PROJECTED_V1" },
        "publishedSchemaVersion": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "currentConsumers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
          },
          "uniqueItems": true,
          "maxItems": 128
        }
      }
    },
    "publicationHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "environments"],
      "properties": {
        "status": { "enum": ["UNCONFIRMED", "NEVER_PUBLISHED", "PUBLISHED"] },
        "environments": {
          "type": "array",
          "items": { "$ref": "#/$defs/publishedEnvironment" },
          "uniqueItems": true,
          "maxItems": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["UNCONFIRMED", "NEVER_PUBLISHED"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": { "environments": { "type": "array", "maxItems": 0 } }
          },
          "else": {
            "properties": { "environments": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "eventVersionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "targetEventType",
        "targetSchemaVersion",
        "migrationPlan"
      ],
      "properties": {
        "decision": {
          "enum": ["UNDECIDED", "EXTEND_V1_BEFORE_FIRST_PUBLISH", "CREATE_V2"]
        },
        "targetEventType": {
          "type": ["string", "null"],
          "enum": [null, "TELEMETRY_PROJECTED_V1", "TELEMETRY_PROJECTED_V2"]
        },
        "targetSchemaVersion": {
          "type": ["string", "null"],
          "pattern": "^[12]\\.[0-9]+$"
        },
        "migrationPlan": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "UNDECIDED" } },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "targetEventType": { "type": "null" },
              "targetSchemaVersion": { "type": "null" },
              "migrationPlan": { "type": "null" }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tdDocument",
        "productionSchema",
        "testPlan",
        "consumerInventory"
      ],
      "properties": {
        "tdDocument": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/versionedArtifact" }]
        },
        "productionSchema": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/productionSchemaArtifact" }
          ]
        },
        "testPlan": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
        },
        "consumerInventory": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/artifact" }]
        }
      }
    },
    "requiredField": {
      "enum": [
        "eventId",
        "eventType",
        "eventVersion",
        "occurredAt",
        "source",
        "eventContentSha256",
        "messageId",
        "contentSha256",
        "tenantId",
        "workloadId",
        "productIdentification",
        "siteCode",
        "deviceIdentification",
        "propertyCode",
        "value",
        "valueEncoding",
        "quality",
        "dataPriority",
        "collectedAt",
        "originalOffset",
        "sequence",
        "configVersion",
        "storeResult"
      ]
    },
    "testArea": {
      "enum": [
        "SCHEMA",
        "IDENTITY_COLLISION",
        "ROUTE",
        "VALUE_QUALITY",
        "TRANSACTION_ROLLBACK",
        "RELAY_RECOVERY",
        "CAPABILITY_ISOLATION"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerRole",
        "approvedBy",
        "approvedAt",
        "decision",
        "decisionRef",
        "contentSha256"
      ],
      "properties": {
        "ownerRole": { "const": "M1/TD-003 owner" },
        "approvedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "approvedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "decision": {
          "enum": ["APPROVE_RECOMMENDATION", "APPROVE_WITH_CHANGES"]
        },
        "decisionRef": { "$ref": "#/$defs/repoPath" },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
