{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaiot.local/events/device.alarm.source-event/v1",
  "title": "AlarmSourceEvent v1 design candidate",
  "type": "object",
  "required": [
    "eventId",
    "eventVersion",
    "eventType",
    "tenantId",
    "occurredAt",
    "recordedAt",
    "source",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "eventType": {
      "enum": ["RAISED", "RECOVERED"]
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "traceId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "sourceType",
        "sourceId",
        "cycleKey",
        "sourceObjectId",
        "siteId",
        "deviceId",
        "severity",
        "occurredAt",
        "payloadHash"
      ],
      "properties": {
        "sourceType": {
          "enum": ["THRESHOLD", "DEVICE_EVENT", "VIDEO", "AI", "RUNTIME"]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cycleKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceObjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "siteId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "propertyCode": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "ruleId": {
          "type": ["string", "null"],
          "maxLength": 64
        },
        "ruleVersion": {
          "type": ["string", "null"],
          "maxLength": 32
        },
        "severity": {
          "enum": ["INFO", "NORMAL", "IMPORTANT", "EMERGENCY"]
        },
        "quality": {
          "enum": ["GOOD", "BACKFILLED", "TIMEOUT", "COMM_ERROR", "DECODE_ERROR", "UNKNOWN"]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "payloadRef": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {"const": "THRESHOLD"}
            },
            "required": ["sourceType"]
          },
          "then": {
            "properties": {
              "propertyCode": {},
              "ruleId": {},
              "ruleVersion": {},
              "quality": {}
            },
            "required": ["propertyCode", "ruleId", "ruleVersion", "quality"]
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
