{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://easyaiot.local/events/device.alarm.created/v1",
  "title": "device.alarm.created.v1",
  "description": "告警首次创建领域事件；alarmId 仅位于 payload。",
  "type": "object",
  "required": [
    "eventId",
    "eventVersion",
    "eventType",
    "tenantId",
    "occurredAt",
    "recordedAt",
    "source",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "eventVersion": {
      "const": "1.0"
    },
    "eventType": {
      "const": "device.alarm.created.v1"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "const": "iot-device"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "traceId": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "payload": {
      "type": "object",
      "required": [
        "alarmId",
        "status",
        "severity",
        "sourceType",
        "sourceId",
        "cycleKey",
        "siteId",
        "deviceId",
        "propertyCode",
        "ruleId",
        "ruleVersion",
        "firstOccurredAt",
        "occurrenceCount"
      ],
      "properties": {
        "alarmId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "status": {
          "enum": ["ACTIVE", "ACKNOWLEDGED", "PROCESSING", "RECOVERED", "CLOSED", "IGNORED", "FALSE_ALARM"]
        },
        "severity": {
          "enum": ["INFO", "NORMAL", "IMPORTANT", "EMERGENCY"]
        },
        "sourceType": {
          "enum": ["THRESHOLD", "DEVICE_EVENT", "VIDEO", "AI", "RUNTIME"]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "cycleKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "siteId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "propertyCode": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "ruleId": {
          "type": ["string", "null"],
          "pattern": "^[1-9][0-9]*$"
        },
        "ruleVersion": {
          "type": ["string", "null"],
          "maxLength": 32
        },
        "firstOccurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "occurrenceCount": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceType": {
                "const": "THRESHOLD"
              }
            },
            "required": ["sourceType"]
          },
          "then": {
            "properties": {
              "propertyCode": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "ruleId": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "ruleVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": true
}
